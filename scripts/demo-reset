#!/usr/bin/env bash
# Put the demo in its starting state: demo clock at a mid-afternoon time, a fresh seeded week.
#   scripts/demo-reset           clock 15:10, reseed
#   scripts/demo-reset 10:25     another time of day (HH:MM, her timezone)
#   scripts/demo-reset real      back to the real clock, reseed
# The clock offset lives in the API process: run this again after every `scripts/dev-up`.
set -euo pipefail
RT=${HEARTH_RUNTIME_ENV:-~/.config/memo-secrets/runtime.env}
API=${HEARTH_API:-http://127.0.0.1:8000}
set -a; . "$RT"; set +a
jar=$(mktemp); trap 'rm -f "$jar"' EXIT
for i in $(seq 1 30); do curl -sf -o /dev/null "$API/api/health" && break; sleep 1; done
code=$(curl -s -c "$jar" -o /dev/null -w '%{http_code}' -H 'content-type: application/json' \
  -d "{\"passcode\":\"$HEARTH_PASSCODE\"}" "$API/api/auth/login")
[ "$code" = 200 ] || { echo "demo-reset: sign-in failed ($code)" >&2; exit 1; }
t=${1:-15:10}
if [ "$t" = real ]; then body='{"reset":true}'; else body="{\"set_time\":\"$t\"}"; fi
curl -sf -b "$jar" -H 'content-type: application/json' -d "$body" "$API/api/demo/clock" >/dev/null
curl -sf -b "$jar" -X POST "$API/api/demo/reset" | python3 -c '
import sys, json
t = json.load(sys.stdin)
print(f"demo-reset: now {t[\"now\"][:16]}Z, {t[\"fluid_ml\"]} of {t[\"fluid_target_ml\"]} ml, {len(t[\"events\"])} events today, {len(t[\"open_alerts\"])} open alerts")'
