# Optional variable names read by the backend, agent and web, including dev/test tools.
# Reference only: all values are intentionally empty. The browser mock needs no keys.

# Core API and browser connection
HEARTH_TRANSPORT= # Call transport selection.
HEARTH_PASSCODE= # Family app sign-in passcode.
HEARTH_SESSION_SECRET= # Cookie session signing secret.
HEARTH_INTERNAL_TOKEN= # Backend-to-agent authentication token.
HEARTH_API_BASE= # Backend URL passed to agent jobs.
HEARTH_API_ORIGIN= # Backend origin for the Next.js proxy.
HEARTH_PUBLIC_URL= # Public app URL used in notifications.
HEARTH_CORS_ORIGINS= # Comma-separated browser origins allowed by the API.
HEARTH_TIMEZONE= # Local timezone for search and digests.
HEARTH_MEDIA_DIR= # Directory for family-uploaded cue photos.
HEARTH_WATCH= # Opt-in watch mode; only 1 enables it (default off).
HEARTH_SCHEDULER= # Enable or disable scheduled check-ins.
HEARTH_RETRY_SECONDS= # Delay before retrying an unanswered check-in.
HEARTH_MOCK_SCALE= # Mock call timing multiplier.
NEXT_PUBLIC_HEARTH_MOCK= # Enable the browser-only mock API.
NEXT_PUBLIC_HEARTH_WS_URL= # Override the browser live-channel WebSocket URL.
NEXT_PUBLIC_HEARTH_MUM_TEL= # Parent's phone number for the call action.
NODE_ENV= # Runtime mode managed by Next.js.

# Tiger Cloud / PostgreSQL
TIGER_DATABASE_URL= # Database connection string; absent uses the in-memory store.

# LiveKit / kiosk / agent worker
LIVEKIT_URL= # LiveKit room server URL.
LIVEKIT_API_KEY= # LiveKit API key.
LIVEKIT_API_SECRET= # LiveKit API signing secret.
HEARTH_AGENT_NAME= # Worker name used for agent dispatch.
HEARTH_KIOSK_DEVICE= # Kiosk device identity.
HEARTH_WORKER_PORT= # Optional agent worker HTTP port.
HEARTH_IDLE_PROCESSES= # Number of idle agent processes.
HEARTH_LOAD_THRESHOLD= # Agent worker load threshold.
HEARTH_PRELIVE_TIMEOUT= # Maximum wait before a call becomes live, in seconds.
HEARTH_NO_ANSWER_ASK_S= # Seconds of silence before asking whether anyone is there.
HEARTH_NO_ANSWER_END_S= # Seconds of silence before ending as unanswered.
HEARTH_REASON_HUNG_UP= # Opt in to the hung-up end reason when supported.
HEARTH_MOTION_MIN= # Motion threshold for visual evidence.
HEARTH_FRAME_MAX_SIDE= # Maximum input video frame dimension.

# Chert FaceTime bridge
CHERT_API_KEY= # Chert API key.
CHERT_PROJECT_ID= # Chert project identifier.
CHERT_LINE_ID= # Chert calling line identifier.
CHERT_IPAD_NUMBER= # Destination iPad FaceTime number.
HEARTH_CHERT_HOOK_KEY= # Authentication key for Chert webhooks.
HEARTH_CHERT_SKIP_LINE_CHECK= # Bypass the Chert line readiness check.
HEARTH_RING_SECONDS= # Ring timeout in seconds.

# Google Gemini
GEMINI_API_KEY= # Gemini key for calls, digests and search.
GOOGLE_API_KEY= # Fallback Gemini key for the agent.
GEMINI_LIVE_MODEL= # Agent voice and vision model.
GEMINI_LIVE_API_VERSION= # Gemini Live API version.
GEMINI_LIVE_VOICE= # Assistant voice selection.
GEMINI_TEXT_MODEL= # Digest and search model.
GEMINI_TTS_MODEL= # Model used by the voice development helper.
HEARTH_MEDIA_RES= # Gemini input media resolution.
HEARTH_SILENCE_MS= # Silence interval for end-of-speech detection.

# Typesense search
TYPESENSE_HOST= # Typesense cluster host.
TYPESENSE_API_KEY= # Typesense API key.
TYPESENSE_COLLECTION= # Event search collection name.
TYPESENSE_HYBRID= # Opt in to embeddings and hybrid search.
TYPESENSE_VOICE= # Opt in to voice questions.

# Web Push / ntfy notifications
VAPID_PRIVATE_KEY= # Web Push private signing key.
VAPID_PUBLIC_KEY= # Web Push public key for browser subscriptions.
VAPID_SUBJECT= # Web Push sender identification URI.
NTFY_URL= # ntfy server URL.
NTFY_TOPIC= # ntfy notification topic.
NTFY_ALL= # Send non-urgent notifications to ntfy too.

# Presidio / text redaction
HEARTH_REDACTION= # Select regex-only redaction or Presidio.
HEARTH_REDACT_NAMES= # Comma-separated family names to redact.

# Optional live tests and browser end-to-end tests
HEARTH_LIVE_NTFY= # Opt in to the live ntfy notification test.
E2E_PORT= # Local web port for Playwright tests.
E2E_BASE_URL= # Existing web server URL for Playwright tests.
